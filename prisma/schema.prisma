// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id          String       @id @default(cuid())
  name        String
  score       Int          @default(0)
  isBanned    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  submissions Submission[]
}

model Puzzle {
  id              String       @id @default(cuid())
  code            String       @unique
  type            String       @default("puzzle")        // "puzzle" or "trivia"
  title           String
  question        String
  answer          String
  points          Int          @default(10)
  hint            String?
  category        String?                               // e.g., "history", "science", "riddle"
  difficulty      String       @default("medium")        // "easy", "medium", "hard"
  imageUrl        String?
  
  // For trivia: multiple choice options
  choices         String?                               // JSON: ["option1", "option2", "option3", "option4"]
  explanation     String?                               // Why the answer is correct
  
  submissions     Submission[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Submission {
  id        String   @id @default(cuid())
  playerId  String
  puzzleId  String
  correct   Boolean
  attempts  Int      @default(1)
  timeSpent Int?                                        // seconds
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  puzzle    Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@unique([playerId, puzzleId])
}

model AppSettings {
  id                 Int     @id @default(1)
  leaderboardVisible Boolean @default(true)
}

model TriviaCategory {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  questions TriviaQuestion[]
}

model TriviaQuestion {
  id         Int    @id @default(autoincrement())
  categoryId Int

  question   String
  optionA    String
  optionB    String
  optionC    String
  optionD    String

  correct    String
  points     Int    @default(10)
  order      Int    @default(0)

  category   TriviaCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model PhotoPuzzle {
  id       Int     @id @default(autoincrement())
  title    String

  imageUrl String
  question String
  answer   String

  points   Int     @default(15)
  active   Boolean @default(true)
}

model GameHub {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  enabledGames  String   @default("[\"trivia\",\"puzzle\"]")
  triviaEnabled Boolean  @default(true)
  puzzleEnabled Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
